# 원본 데이터의 이미지 파일 (용량 문제로 git 제외)
data/raw/**/*.jpg
data/raw/**/*.jpeg
data/raw/**/*.png
data/raw/**/*.gif
data/raw/**/*.webp
data/raw/**/*.bmp
data/raw/**/*.tif
data/raw/**/*.tiff

# 원본 데이터는 로컬에만 보관 (받는 방법: docs/raw-data.md)
data/raw/*
!data/raw/.gitkeep
!data/raw/*/
data/raw/*/*
!data/raw/*/.gitkeep
!data/raw/data_go_kr/links.csv

