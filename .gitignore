# 원본 데이터의 이미지 파일 (용량 문제로 git 제외)
data/raw/**/*.jpg
data/raw/**/*.jpeg
data/raw/**/*.png
data/raw/**/*.gif
data/raw/**/*.webp
data/raw/**/*.bmp
data/raw/**/*.tif
data/raw/**/*.tiff

# 원본 데이터는 로컬에만 보관 (받는 방법: docs/raw-data.md)
data/raw/*
!data/raw/.gitkeep
!data/raw/*/
data/raw/*/*
!data/raw/*/.gitkeep
!data/raw/data_go_kr/links.csv

# 환경 · 파이썬
/.env
.venv/
__pycache__/
*.pyc
.DS_Store

# Node (루트 실행 스크립트용)
/node_modules/

# 평가 실행 결과 (실험 문서에 쓴 폴더만 git add -f 로 올림)
outputs/chat_eval/

# 통합 사진과 HWP 변환 중간 파일 (목록 CSV·문서는 Git 관리)
/data/processed/photos/
/outputs/place_photos/
/data/processed/photos_web/
/outputs/photo_web/

# 데이터 공유용 대용량 압축 파일
/data/**/*.zip
/outputs/**/*.zip
